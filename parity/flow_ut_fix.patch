+        # Not a built/installed ascend tree — nothing to shadow; callers
+        # grade the tree as-is rather than failing the check here.
+        return None
+    view_root = WORKSPACE_DIR / "ut_purecpu_view"
+    shutil.rmtree(view_root, ignore_errors=True)
+    view_pkg = view_root / "vllm_ascend"
+    view_pkg.mkdir(parents=True)
+    for entry in os.scandir(pkg):

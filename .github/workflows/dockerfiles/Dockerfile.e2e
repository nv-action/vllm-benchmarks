ARG BASE_IMAGE
FROM ${BASE_IMAGE}
SHELL ["/bin/bash", "-eo", "pipefail", "-c"]

RUN apt-get update -y && \
    apt-get install -y --no-install-recommends python3-pip git vim wget net-tools \
      gcc g++ cmake libnuma-dev curl gnupg2 zstd clang-15 \
      libibverbs1 ibverbs-providers librdmacm1 libnuma1 util-linux coreutils && \
    update-alternatives --install /usr/bin/clang clang /usr/bin/clang-15 20 && \
    update-alternatives --install /usr/bin/clang++ clang++ /usr/bin/clang++-15 20 && \
    pip install --no-cache-dir uv && rm -rf /var/lib/apt/lists/*

ENV UV_EXTRA_INDEX_URL="https://mirrors.huaweicloud.com/ascend/repos/pypi https://mirrors.huaweicloud.com/ascend/repos/pypi/nightly https://download.pytorch.org/whl/cpu/" \
    UV_INDEX_STRATEGY=unsafe-best-match UV_HTTP_TIMEOUT=120 UV_NO_CACHE=1 UV_SYSTEM_PYTHON=1

ARG VLLM_COMMIT
RUN git init /vllm-workspace/vllm && \
    git -C /vllm-workspace/vllm fetch --depth 1 https://github.com/vllm-project/vllm.git "${VLLM_COMMIT}" && \
    git -C /vllm-workspace/vllm checkout --detach FETCH_HEAD && \
    VLLM_TARGET_DEVICE=empty uv pip install -e /vllm-workspace/vllm && \
    pip uninstall -y triton

WORKDIR /vllm-workspace/vllm-ascend
COPY requirements.txt requirements-dev.txt requirements-lint.txt ./
ARG DEVICE
RUN source /usr/local/Ascend/ascend-toolkit/set_env.sh && \
    uv pip install -r requirements-dev.txt && \
    uv pip install 'mooncake-transfer-engine-npu===0.3.14' && \
    uv pip install --no-deps "flash-linear-attention-npu-${DEVICE}===26.10.0+feature" && \
    if [ "$DEVICE" = a3 ]; then \
      TORCH_DEVICE_BACKEND_AUTOLOAD=0 python3 -m memfabric_hybrid.cli kernel install --soc-version A3; \
    fi && \
    uv pip install --force-reinstall --no-deps 'triton-ascend===3.6.0.post2'

# The workflow supplies a clean checkout and separate, already restored caches.
COPY . ./
COPY --from=workflow_helpers build_e2e_csrc.sh run_e2e_image_tests.sh .github/workflows/scripts/
ARG CSRC_CACHE=off
ARG CSRC_CACHE_HIT=false
ARG SOC_VERSION=ascend910b1
ARG MAX_JOBS=4
RUN --mount=type=bind,from=csrc_l0,target=/tmp/vllm_ascend \
    --mount=type=bind,from=csrc_l1,target=/tmp/build_cache,rw \
    --mount=type=cache,id=csrc-${SOC_VERSION}-arm64,target=/vllm-workspace/vllm-ascend/csrc/build_cache,sharing=locked \
    source /usr/local/Ascend/ascend-toolkit/set_env.sh && \
    source /usr/local/Ascend/nnal/atb/set_env.sh && \
    export LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:/usr/local/Ascend/ascend-toolkit/latest/$(uname -m)-linux/devlib" && \
    bash .github/workflows/scripts/build_e2e_csrc.sh \
      "$CSRC_CACHE" "$CSRC_CACHE_HIT" /tmp/vllm_ascend /tmp/build_cache /vllm-workspace/vllm-ascend/csrc/build_cache && \
    pip freeze > /vllm-workspace/packages.txt

ARG SOURCE_SHA
LABEL org.opencontainers.image.revision="${SOURCE_SHA}" \
      ai.vllm.e2e.vllm-revision="${VLLM_COMMIT}" \
      ai.vllm.e2e.soc="${SOC_VERSION}"
CMD ["/bin/bash"]

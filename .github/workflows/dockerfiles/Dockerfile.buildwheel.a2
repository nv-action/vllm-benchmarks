ARG PY_VERSION=3.12
FROM quay.io/ascend/manylinux:9.2.0-910b-manylinux_2_34-py${PY_VERSION}

ARG SOC_VERSION="ascend910b1"

# Define environments
ENV DEBIAN_FRONTEND=noninteractive
ENV SOC_VERSION=$SOC_VERSION
RUN yum update -y && \
    yum install -y python3-pip git vim wget net-tools gcc gcc-c++ make cmake numactl-devel && \
    rm -rf /var/cache/yum

WORKDIR /workspace

COPY . /workspace/vllm-ascend/

# Install req
RUN python3 -m pip install -r vllm-ascend/requirements.txt --extra-index https://download.pytorch.org/whl/cpu/ --extra-index-url https://repo.huaweicloud.com/ascend/repos/pypi && \
    python3 -m pip install twine attrs psutil

# Install the rc2 snapshots using the same script and versions as Dockerfile.
RUN BUILD_TYPE=daily DAILY_DEPS_MODE=full \
    MEMFABRIC_VERSION=1.3.0 MEMFABRIC_DATE=20261009.10 \
    MEMCACHE_VERSION=1.3.0 MEMCACHE_DATE=20261009.15 \
    TORCH_NPU_VERSION=26.2.0 TORCH_NPU_DATE=20260926.5 \
    TRITON_ASCEND_VERSION=20260923230212 \
    TRITON_ASCEND_PACKAGE_VERSION=3.6.0%2Bdev20260923230212 \
    bash vllm-ascend/.github/workflows/scripts/install_daily_deps.sh && \
    sed -i \
        -e 's/torch-npu==2\.10\.0\.post4/torch-npu==2.10.0.post7/g' \
        -e 's/triton-ascend==3\.2\.2/triton-ascend==3.6.0+dev20260923230212/g' \
        -e 's/memfabric_hybrid==1\.2\.0/memfabric_hybrid==1.3.0/g' \
        -e 's/memcache_hybrid==1\.2\.0/memcache_hybrid==1.3.0/g' \
        vllm-ascend/requirements.txt vllm-ascend/pyproject.toml

# Temporary rc2 validation after dependency installation, before compilation.
RUN python3 vllm-ascend/.github/workflows/scripts/wheel/check_rc2_environment.py

# Install vllm-ascend
RUN source /usr/local/Ascend/ascend-toolkit/set_env.sh && \
    source /usr/local/Ascend/nnal/atb/set_env.sh && \
    export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/usr/local/Ascend/ascend-toolkit/latest/`uname -i`-linux/devlib && \
    cd vllm-ascend && \
    SETUPTOOLS_SCM_PRETEND_VERSION=0.30.0rc2 python3 setup.py bdist_wheel && \
    ls -l dist

CMD ["/bin/bash"]
